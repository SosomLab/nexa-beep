<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>nexa-beep-portable</id>
    <version>@VERSION@</version>
    <packageSourceUrl>https://github.com/SosomLab/nexa-beep/tree/main/packaging/choco/portable</packageSourceUrl>
    <owners>SosomLab</owners>
    <title>Nexa Beep (Portable)</title>
    <authors>Sangyong Bae</authors>
    <projectUrl>https://github.com/SosomLab/nexa-beep</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/SosomLab/nexa-beep@v@VERSION@/packaging/branding/nexa-beep-256.png</iconUrl>
    <licenseUrl>https://github.com/SosomLab/nexa-beep/blob/main/LICENSE.md</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/SosomLab/nexa-beep</projectSourceUrl>
    <bugTrackerUrl>https://github.com/SosomLab/nexa-beep/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/SosomLab/nexa-beep/releases/tag/v@VERSION@</releaseNotes>
    <tags>chat lan messenger p2p zero-config</tags>
    <summary>Zero-config local network messenger</summary>
    <description>
No server address, no account, no contact registration. Launch it and everyone
running Nexa Beep on the same local network shows up in your list — pick one
and start talking immediately.

Messages are end-to-end encrypted between devices, and every received file must
pass a sanitization gate before it materializes on disk. A single executable
with no runtime dependencies.

License: PolyForm Noncommercial 1.0.0 (noncommercial use).
    </description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
