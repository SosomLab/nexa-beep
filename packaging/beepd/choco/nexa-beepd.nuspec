  <metadata>
    <id>nexa-beepd</id>
    <version>@VERSION@</version>
    <packageSourceUrl>https://github.com/SosomLab/nexa-beep/tree/main/packaging/beepd/choco</packageSourceUrl>
    <owners>SosomLab</owners>
    <title>nexa-beepd (Relay Server)</title>
    <authors>Sangyong Bae</authors>
    <projectUrl>https://github.com/SosomLab/nexa-beep</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/SosomLab/nexa-beep@beepd-v@VERSION@/packaging/branding/nexa-beep-256.png</iconUrl>
    <licenseUrl>https://github.com/SosomLab/nexa-beep/blob/main/LICENSE.md</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/SosomLab/nexa-beep</projectSourceUrl>
